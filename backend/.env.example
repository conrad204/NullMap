ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=studies
# True only for the unsecured local Docker service. False for Elastic Cloud.
ELASTIC_LOCAL=true
OPENAI_API_KEY=
# Public S3 snapshot; no OpenAlex API key or AWS credentials required.
OPENALEX_SNAPSHOT_MANIFEST=https://openalex.s3.amazonaws.com/data/parquet/works/manifest.json
HF_TOKEN=
SMALL_MODEL=gpt-4.1-mini
NARRATION_MODEL=gpt-4.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
EMBEDDINGS_ENABLED=true
REFERENCE_MIN_SIMILARITY=0.55
CLASSIFIER_MODEL_PATH=
EXTRACTION_LIMIT=30
LLM_CONCURRENCY=5
EXTRACTION_CACHE_VERSION=v3-arm-summaries
# Query-time full text from Europe PMC (keyless) for papers with a PMCID; abstract otherwise.
FULLTEXT_ENABLED=true
EUROPEPMC_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
FULLTEXT_MAX_LINES=160
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Estimated USD / million tokens; update for your chosen models/rates.
SMALL_INPUT_PRICE=0.4
SMALL_CACHED_PRICE=0.1
SMALL_OUTPUT_PRICE=1.6
NARRATION_INPUT_PRICE=2.0
NARRATION_CACHED_PRICE=0.5
NARRATION_OUTPUT_PRICE=8.0
TTC_API_KEY=
TTC_MODEL=bear-2
# Enable only after running the paired compression benchmark and reviewing it.
COMPRESSION_ENABLED=false
COMPRESSION_VALIDATED=false
# Set the actual TTC price before comparing dollar savings.
TTC_INPUT_PRICE=0
# Optional batch-machine access; used by your SSH client, not the API service.
VOLORIDGE_SSH_HOST=
VOLORIDGE_SSH_PASSWORD=
